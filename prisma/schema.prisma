  claimId     String
  adminUserId String
  action      String          // CREATE_CLAIM, RUN_AUDIT, RE_RUN_AUDIT, UPDATE_STATUS, APPROVE_REFUND, REJECT_CLAIM, REQUEST_EVIDENCE, UPDATE_NOTES
  result      String?
  details     Json?
  createdAt   DateTime        @default(now())

  claim       ProtectionClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  adminUser   User            @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@index([adminUserId])
  @@index([createdAt])
}

// ─── Referral & Affiliate Program ─────────────────────────────────────────────

enum AffiliateStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REVERSED
  EXPIRED
}

enum RewardStatus {
  PENDING
  APPROVED
  REVERSED
}

enum ReferralLedgerType {
  EARNED
  APPLIED_TO_INVOICE
  REVERSED
  ADJUSTMENT
}

model Affiliate {
  id            String                @id @default(cuid())
  userId        String?               @unique
  code          String                @unique
  name          String?
  status        AffiliateStatus       @default(ACTIVE)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  user          User?                 @relation("UserAffiliate", fields: [userId], references: [id], onDelete: SetNull)
  referrals     Referral[]
  rewards       ReferralReward[]
  ledgerEntries ReferralLedgerEntry[]

  @@index([code])
  @@index([status])
  @@index([userId])
}

model Referral {
  id             String         @id @default(cuid())
  affiliateId    String
  referredUserId String         @unique
  status         ReferralStatus @default(PENDING)
  clickedAt      DateTime?
  signedUpAt     DateTime       @default(now())
  qualifiedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  affiliate      Affiliate      @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referredUser   User           @relation("UserReferral", fields: [referredUserId], references: [id], onDelete: Cascade)
  rewards        ReferralReward[]

  @@index([affiliateId])
  @@index([status])
}

model ReferralReward {
  id               String       @id @default(cuid())
  affiliateId      String
  referralId       String
  referredUserId   String
  subscriptionId   String?
  paymentInvoiceId String?      @unique
  rate             Decimal      @db.Decimal(5, 4)
  baseAmount       Decimal      @db.Decimal(10, 2)
  rewardAmount     Decimal      @db.Decimal(10, 2)
  status           RewardStatus @default(APPROVED)
  appliedAt        DateTime?
  reversalReason   String?      @db.Text
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  affiliate        Affiliate    @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referral         Referral     @relation(fields: [referralId], references: [id], onDelete: Cascade)
  referredUser     User         @relation("UserReferralRewards", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@index([referralId])
  @@index([status])
}

model ReferralLedgerEntry {
  id           String             @id @default(cuid())
  affiliateId  String
  type         ReferralLedgerType
  amount       Decimal            @db.Decimal(10, 2)
  balanceAfter Decimal            @db.Decimal(10, 2)
  description  String?
  referenceId  String?
  createdAt    DateTime           @default(now())

  affiliate    Affiliate          @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId, createdAt])
}

// ─── Team Invitations ─────────────────────────────────────────────────────────

enum TeamInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

model TeamInvitation {
  id          String               @id @default(cuid())
  inviterId   String
  email       String
  name        String?
  role        UserRole             @default(CHAT_ONLY)
  codeHash    String
  status      TeamInvitationStatus @default(PENDING)
  expiresAt   DateTime
  lastSentAt  DateTime             @default(now())
  sendCount   Int                  @default(1)
  acceptedAt  DateTime?
  cancelledAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  inviter     User                 @relation("UserTeamInvitations", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([inviterId, status])
  @@index([email, status])
  @@index([expiresAt])
}

// ─── Manual Payment System ───────────────────────────────────────────────────
// النظام الرسمي الحالي للدفع (InstaPay / Etisalat Cash + مراجعة إدارية).
// Fawaterak (src/lib/fawaterak.ts وما يستخدمه) مُعزول ومُعطّل — راجع التعليقات
// هناك. لا تُنشئ أي منطق دفع جديد يعتمد عليه.
enum PaymentRequestType {
  subscription
  token_package
  mcp_addon
}

enum PaymentRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model PaymentRequest {
  id              String                @id @default(cuid())
  userId          String
  type            PaymentRequestType
  // subscription: planSlug + cycle مطلوبين. token_package/mcp_addon: packageId مطلوب.
  planSlug        String?
  cycle           String?
  packageId       String?
  productName     String
  amount          Int
  currency        String                @default("EGP")
  paymentMethod   String?
  status          PaymentRequestStatus  @default(PENDING)
  requestedAt     DateTime              @default(now())
  reviewedAt      DateTime?
  reviewedById    String?
  rejectionReason String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  user            User                  @relation("UserPaymentRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy      User?                 @relation("PaymentRequestReviewer", fields: [reviewedById], references: [id])

  @@index([userId])
  @@index([status])
  @@index([userId, status])
  @@index([createdAt])
}




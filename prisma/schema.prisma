generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                       String                    @id @default(cuid())
  email                    String                    @unique
  name                     String?
  phone                    String?
  password                 String?
  image                    String?
  emailVerified            DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  apiKey                   String?                   @unique
  role                     UserRole                  @default(OWNER)
  inviteCode               String?                   @unique
  parentId                 String?
  workspaceId              String?
  isSuper                  Boolean                   @default(false)
  deletedAt                DateTime?
  deletedBy                String?
  brandName                String?
  businessDesc             String?
  productsInfo             String?
  pricingInfo              String?
  workingHours             String?
  aiTone                   String                    @default("friendly")
  onboardingCompleted      Boolean                   @default(false)
  signupMethod             SignupMethod              @default(MANUAL)
  aiAgent                  AIAgent?
  aiGuardrail              AIGuardrail?
  accounts                 Account[]
  affiliate                Affiliate?                @relation("UserAffiliate")
  audiences                Audience[]
  automationAnalytics      AutomationAnalytics[]
  automationInteractions   AutomationInteraction[]
  automationRules          AutomationRule[]
  brandFAQs                BrandFAQ[]
  brandPolicies            BrandPolicy[]
  customerIssues           CustomerIssue[]
  customerServiceSettings  CustomerServiceSettings?
  agentTrainingRules       AgentTrainingRule[]
  campaigns                Campaign[]
  campaignFollowUpRecords  CampaignFollowUpRecord[]
  campaignFollowUpSettings CampaignFollowUpSetting[]
  assignedConversations    Contact[]                 @relation("AssignedConversations")
  contacts                 Contact[]
  easyOrdersStore          EasyOrdersStore?
  emailVerificationTokens  EmailVerificationToken[]
  googleSheetsConnections  GoogleSheetsConnection[]
  sentMessages             Message[]                 @relation("MessageSender")
  messages                 Message[]
  messageQueues            MessageQueue[]
  notifications            Notification[]
  reviewedPaymentRequests  PaymentRequest[]          @relation("PaymentRequestReviewer")
  paymentRequests          PaymentRequest[]          @relation("UserPaymentRequests")
  products                 Product[]
  productSyncLogs          ProductSyncLog[]
  protectionAuditLogs      ProtectionAuditLog[]
  reviewedProtectionClaims ProtectionClaim[]         @relation("ReviewedProtectionClaims")
  protectionClaims         ProtectionClaim[]
  pushSubscriptions        PushSubscription[]
  referral                 Referral?                 @relation("UserReferral")
  receivedRewards          ReferralReward[]          @relation("UserReferralRewards")
  salesBehaviorSettings    SalesBehaviorSettings?
  shopifyStore             ShopifyStore?
  smartFollowUpSettings    SmartFollowUpSetting[]
  storeAutomations         StoreAutomation[]
  storeOrders              StoreOrder[]
  subscription             Subscription?
  teamInvitations          TeamInvitation[]          @relation("UserTeamInvitations")
  templates                Template[]
  trackedClicks            TrackedClick[]
  parent                   User?                     @relation("TeamHierarchy", fields: [parentId], references: [id])
  members                  User[]                    @relation("TeamHierarchy")
  waniPartnerCards         WaniPartnerCard[]
  websiteCrawlSettings     WebsiteCrawlSettings?
  websitePages             WebsitePage[]
  whatsappAccount          WhatsAppAccount?
  wooCommerceStore         WooCommerceStore?

  @@index([email])
  @@index([workspaceId])
  @@index([parentId])
  @@index([deletedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Subscription {
  id                       String             @id @default(cuid())
  userId                   String             @unique
  plan                     PlanTier           @default(free)
  status                   SubscriptionStatus @default(active)
  isBetaUser               Boolean            @default(false)
  campaignsUsedThisMonth   Int                @default(0)
  mcpCommandsUsedThisMonth Int                @default(0)
  periodResetAt            DateTime           @default(now())
  aiTokensUsedThisMonth    Int                @default(0)
  aiTokensBonusBalance     Int                @default(0)
  currentPeriodStart       DateTime           @default(now())
  currentPeriodEnd         DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  expiryWarningSentAt      DateTime?
  aiTokensBonusExpiresAt   DateTime?
  user                     User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([plan])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expires   DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model WhatsAppAccount {
  id                       String                  @id @default(cuid())
  userId                   String                  @unique
  accessToken              String
  phoneNumberId            String
  wabaId                   String                  @unique
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  backoffCount             Int                     @default(0)
  backoffUntil             DateTime?
  dailyResetAt             DateTime                @default(now())
  dailySentCount           Int                     @default(0)
  messagingTier            Int                     @default(1)
  tokenStatus              WhatsAppTokenStatus     @default(UNKNOWN)
  tokenExpiresAt           DateTime?
  lastTokenCheckAt         DateTime?
  tokenDataAccessExpiresAt DateTime?
  tokenWarning7SentAt      DateTime?
  tokenWarning3SentAt      DateTime?
  tokenWarning1SentAt      DateTime?
  tokenExpiredNotifiedAt   DateTime?
  tokenInvalidNotifiedAt   DateTime?
  automationInteractions   AutomationInteraction[]
  messageQueues            MessageQueue[]
  protectionClaims         ProtectionClaim[]
  user                     User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MessageQueue {
  id                String          @id @default(cuid())
  userId            String
  whatsappAccountId String
  phoneNumberId     String
  toPhone           String
  contactId         String?
  messageType       String          @default("template")
  templateName      String?
  templateLang      String          @default("ar")
  templateVars      Json?
  content           String?
  campaignId        String?
  status            QueueStatus     @default(pending)
  scheduledAt       DateTime        @default(now())
  processedAt       DateTime?
  sentAt            DateTime?
  attempts          Int             @default(0)
  maxAttempts       Int             @default(3)
  nextRetryAt       DateTime?
  whatsappMsgId     String?
  error             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  existingMessageId String?
  replyToWhatsappId String?
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  whatsappAccount   WhatsAppAccount @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([phoneNumberId, status])
  @@index([campaignId])
  @@index([userId, status])
  @@index([status, nextRetryAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  link      String?
  meta      Json?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
}

model Audience {
  id                     String                  @id @default(cuid())
  name                   String
  userId                 String
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  type                   String                  @default("excel")
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts               Contact[]
  googleSheetsConnection GoogleSheetsConnection?

  @@index([userId])
}

model GoogleSheetsConnection {
  id              String    @id @default(cuid())
  userId          String
  audienceId      String?   @unique
  accessToken     String?
  refreshToken    String?
  tokenExpiresAt  DateTime?
  spreadsheetId   String?
  spreadsheetName String?
  sheetId         String?
  sheetName       String?
  nameColumn      String?
  phoneColumn     String?
  lastSyncAt      DateTime?
  syncInterval    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  audience        Audience? @relation(fields: [audienceId], references: [id])
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, syncInterval, lastSyncAt])
}

model Contact {
  id                     String                  @id @default(cuid())
  phone                  String
  audienceId             String?
  createdAt              DateTime                @default(now())
  name                   String?
  userId                 String
  deletedAt              DateTime?
  isArchived             Boolean                 @default(false)
  isPinned               Boolean                 @default(false)
  lastMessageAt          DateTime?
  notes                  String?
  unreadCount            Int                     @default(0)
  updatedAt              DateTime                @updatedAt
  voiceAgentEnabled      Boolean                 @default(false)
  voiceOptOut            Boolean                 @default(false)
  lastAiRepliedAt        DateTime?
  textAiEnabled          Boolean                 @default(true)
  aiStatus               ConversationStatus      @default(AUTO)
  handoffAt              DateTime?
  handoffReason          String?
  nudgeCountInThread     Int                     @default(0)
  assignedToUserId       String?
  automationInteractions AutomationInteraction[]
  assignedTo             User?                   @relation("AssignedConversations", fields: [assignedToUserId], references: [id])
  audience               Audience?               @relation(fields: [audienceId], references: [id])
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages               Message[]
  storeOrders            StoreOrder[]
  agentTrainingRules     AgentTrainingRule[]

  @@unique([phone, userId])
  @@index([userId])
  @@index([assignedToUserId])
  @@index([phone])
  @@index([lastMessageAt])
}

model Template {
  id                       String                    @id @default(cuid())
  name                     String
  content                  String
  status                   String                    @default("pending")
  userId                   String
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  metaId                   String
  category                 String                    @default("MARKETING")
  language                 String                    @default("ar")
  headerType               String?
  headerText               String?
  footer                   String?
  buttons                  Json?
  rejectedReason           String?
  components               Json?
  automationRules          AutomationRule[]
  campaigns                Campaign[]
  campaignFollowUpSettings CampaignFollowUpSetting[]
  storeAutomations         StoreAutomation[]
  user                     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([metaId, userId])
  @@index([userId])
  @@index([status])
}

model Campaign {
  id                String          @id @default(cuid())
  name              String
  userId            String
  templateId        String?
  sentCount         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  completedAt       DateTime?
  deliveredCount    Int             @default(0)
  failedCount       Int             @default(0)
  readCount         Int             @default(0)
  startedAt         DateTime?
  status            CampaignStatus  @default(draft)
  scheduledAt       DateTime?       @map("scheduled_at")
  queuedCount       Int             @default(0)
  totalQueued       Int             @default(0)
  ordersCount       Int             @default(0)
  revenue           Float           @default(0)
  trackedUrl        String?
  attributionHours  Int             @default(48)
  templateVariables Json?
  template          Template?       @relation(fields: [templateId], references: [id])
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignOrders    CampaignOrder[]
  messages          Message[]

  @@index([userId])
  @@index([status])
  @@index([scheduledAt])
}

model Message {
  id               String            @id @default(cuid())
  content          String?
  userId           String
  campaignId       String?
  contactId        String
  whatsappId       String?           @unique
  createdAt        DateTime          @default(now())
  deletedAt        DateTime?
  deliveredAt      DateTime?
  error            String?
  mediaUrl         String?
  readAt           DateTime?
  sentAt           DateTime?
  type             MessageType       @default(text)
  updatedAt        DateTime          @updatedAt
  status           MessageStatus     @default(pending)
  direction        MessageDirection  @default(outbound)
  senderType       MessageSenderType @default(human)
  reactions        Json?             @default("[]")
  replyToMessageId String?
  automationRuleId String?
  senderUserId     String?
  automationRule   AutomationRule?   @relation(fields: [automationRuleId], references: [id])
  campaign         Campaign?         @relation(fields: [campaignId], references: [id])
  contact          Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  replyTo          Message?          @relation("MessageReply", fields: [replyToMessageId], references: [id])
  replies          Message[]         @relation("MessageReply")
  senderUser       User?             @relation("MessageSender", fields: [senderUserId], references: [id])
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([senderUserId])
  @@index([contactId])
  @@index([campaignId])
  @@index([automationRuleId])
  @@index([status])
  @@index([createdAt])
  @@index([contactId, createdAt])
  @@index([senderType])
}

model WebhookLog {
  id        String   @id @default(cuid())
  payload   String
  processed Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String?

  @@index([processed])
  @@index([createdAt])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  brandName String
  phone     String
  rating    Int
  content   String
  approved  Boolean  @default(false)
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([approved])
  @@index([createdAt])
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  discountType  String    @default("percent")
  discountValue Float
  maxUses       Int       @default(1)
  usedCount     Int       @default(0)
  expiresAt     DateTime?
  active        Boolean   @default(true)
  /// null = كل الباقات | "starter" | "pro" | "enterprise"
  forPlan       String?
  createdAt     DateTime  @default(now())

  @@index([code])
  @@index([active])
}

/// كارت "WANI Partner" في الداشبورد — اليوزر بيصمم كارته من صفحة
/// /dashboard/wani-partner، وبيدخل الـ rotation بعد موافقة الأدمن من
/// تاب "WANI Partner" في /dashboard/admin (src/app/dashboard/page.tsx بيعرض
/// المعتمد والمفعّل بس).
model WaniPartnerCard {
  id              String                @id @default(cuid())
  /// شكل/حركة الكارت — رقم من 1 لـ 5 (كل رقم تصميم وانيميشن مختلف)
  template        Int                   @default(1)
  brandName       String
  title           String
  tagline         String
  ctaText         String
  ctaLink         String
  /// صورة الخلفية بس (Cloudinary) — من غير أي نص عليها، النص بيتحط بالكود فوقها
  image           String
  /// تشغيل/إيقاف — بيتحكم فيه اليوزر نفسه بعد الموافقة، من غير ما يحتاج مراجعة تانية
  active          Boolean               @default(true)
  /// ترتيب الظهور في الـ rotation — الأدمن بيظبطه بين الكروت المعتمدة
  order           Int                   @default(0)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  userId          String
  /// حالة مراجعة الأدمن — أي تعديل في المحتوى بيرجّعها pending تاني
  status          WaniPartnerCardStatus @default(pending)
  rejectionReason String?
  reviewedAt      DateTime?
  reviewedBy      String?
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([active])
  @@index([order])
  @@index([userId])
}

model ShopifyStore {
  id          String            @id @default(cuid())
  userId      String            @unique
  shop        String            @unique
  storeName   String
  accessToken String?
  scope       String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  automations StoreAutomation[]
  orders      StoreOrder[]
}

model EasyOrdersStore {
  id            String            @id @default(cuid())
  userId        String            @unique
  storeName     String
  apiKey        String
  // EasyOrders بتولّد سِر (secret) منفصل لكل Webhook بيتعمل، حتى لو كل الـ
  // Webhooks بتشاور على نفس الـ URL. عشان كده لازم سِرّين منفصلين — واحد
  // للـ Webhook من نوع "Orders" (order created) وواحد للـ Webhook من نوع
  // "Order Status Update". كلاهما اختياري لحد ما المستخدم يعمل الـ Webhook
  // المطابق من داشبورد EasyOrders ويلصق السر هنا — لا يُشتق أبدًا من apiKey.
  webhookSecretOrders       String?
  webhookSecretStatusUpdate String?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  lastSyncAt    DateTime?
  totalSynced   Int               @default(0)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  automations   StoreAutomation[]
  orders        StoreOrder[]

  @@index([userId])
}

model WooCommerceStore {
  id             String            @id @default(cuid())
  userId         String            @unique
  storeName      String
  storeUrl       String?
  isActive       Boolean           @default(true)
  totalSynced    Int               @default(0)
  lastSyncAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  consumerKey    String?
  consumerSecret String?
  isConnected    Boolean           @default(false)
  automations    StoreAutomation[]
  orders         StoreOrder[]
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AutomationRule {
  id                String                  @id @default(cuid())
  userId            String
  name              String
  isEnabled         Boolean                 @default(true)
  triggerType       TriggerType
  triggerValue      String?
  replyType         ReplyType
  replyContent      String?
  replyMediaUrl     String?
  templateId        String?
  extraInstructions String?
  humanKeywords     String[]
  pauseOnReply      Boolean                 @default(true)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  interactiveConfig Json?
  analytics         AutomationAnalytics[]
  interactions      AutomationInteraction[]
  template          Template?               @relation(fields: [templateId], references: [id])
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages          Message[]

  @@index([userId, isEnabled])
  @@index([triggerType])
  @@index([userId, triggerType])
}

model AutomationInteraction {
  id                String                     @id @default(cuid())
  userId            String
  contactId         String
  whatsappAccountId String
  phoneNumberId     String
  automationRuleId  String
  outboundMessageId String?
  buttonSnapshot    Json
  state             AutomationInteractionState @default(WAITING)
  selectedButtonId  String?
  processedEventId  String?                    @unique
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  completedAt       DateTime?
  automationRule    AutomationRule             @relation(fields: [automationRuleId], references: [id], onDelete: Cascade)
  contact           Contact                    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  whatsappAccount   WhatsAppAccount            @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)

  @@index([userId, contactId, state])
  @@index([contactId, state, createdAt])
  @@index([whatsappAccountId, phoneNumberId])
  @@index([automationRuleId])
}

model AIAgent {
  id                   String                @id @default(cuid())
  userId               String                @unique
  isEnabled            Boolean               @default(false)
  provider             AIProvider            @default(gemini)
  brandName            String?
  businessDesc         String?
  productsInfo         String?
  pricingInfo          String?
  workingHours         String?
  tone                 String                @default("friendly")
  systemPrompt         String?
  pauseMinutes         Int                   @default(10)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  elevenLabsEnabled    Boolean               @default(false)
  elevenLabsApiKey     String?
  elevenLabsAgentId    String?
  voiceRepliesEnabled  Boolean               @default(false)
  elevenLabsVoiceId    String?
  elevenLabsModelId    String?
  languageMode         String                @default("auto")
  websiteButtonText    String?
  websiteUrl           String?
  handoffResumeMinutes Int?                  @default(3)
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  analytics            AutomationAnalytics[]
}

model Product {
  id                  String        @id @default(cuid())
  userId              String
  source              ProductSource
  externalId          String
  name                String
  description         String?
  price               Float?
  compareAtPrice      Float?
  currency            String        @default("EGP")
  images              String[]      @default([])
  variants            Json?
  stock               Int?
  url                 String?
  category            String?
  tags                String[]      @default([])
  isActive            Boolean       @default(true)
  searchText          String
  lastSyncedAt        DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  relatedProductIds   String[]      @default([])
  aiNotes             String?
  aiKeywords          String[]      @default([])
  aiSalesInstructions String?
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([source, externalId, userId])
  @@index([userId, isActive])
  @@index([userId, source])
}

model BrandFAQ {
  id        String   @id @default(cuid())
  userId    String
  question  String
  answer    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BrandPolicy {
  id        String     @id @default(cuid())
  userId    String
  type      PolicyType
  title     String
  content   String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AIGuardrail {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  noInventPrices          Boolean  @default(true)
  noInventProducts        Boolean  @default(true)
  noMentionCompetitors    Boolean  @default(true)
  noSharePersonal         Boolean  @default(true)
  strictKnowledgeOnly     Boolean  @default(true)
  alwaysHandoffComplaints Boolean  @default(true)
  customRules             String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  responseStyle           String   @default("natural")
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CustomerIssue {
  id         String   @id @default(cuid())
  userId     String
  problem    String   @db.Text
  resolution String   @db.Text
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CustomerServiceSettings {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  generalSupportInfo     String?  @db.Text
  supportProcess         String?  @db.Text
  escalationInstructions String?  @db.Text
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AgentTrainingRule {
  id               String              @id @default(cuid())
  userId           String
  contactId        String?
  messageId        String?
  feedback         String              @db.Text
  contextSnapshot  Json?
  type             TrainingRuleType?
  content          String?             @db.Text
  extractedData    Json?
  appliesTo        String?
  status           TrainingRuleStatus  @default(pending)
  confidence       Float?
  extractionModel  String?
  extractionError  String?
  appliedTable     String?
  appliedRecordId  String?
  reviewedByUserId String?
  reviewedAt       DateTime?

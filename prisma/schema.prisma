generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                    @id @default(cuid())
  email                    String                    @unique
  name                     String?
  phone                    String?
  password                 String? // nullable — يوزر Google مش عنده password
  image                    String?
  emailVerified            DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  apiKey                   String?                   @unique
  role                     UserRole                  @default(OWNER)
  // مصدر إنشاء الحساب — بيحدد هل اليوزر لازم يمر على Google Onboarding ولا لأ.
  // MANUAL = سجل بإيميل وباسورد بنفسه (البيانات كلها اتاخدت وقت التسجيل)
  // GOOGLE = سجل بـ Continue with Google (ممكن يحتاج يكمل بيانات زي رقم الواتساب)
  // TEAM_INVITE = انضم كـ Team Member عن طريق دعوة — لا يمر على أي Onboarding إطلاقًا
  signupMethod             SignupMethod              @default(MANUAL)
  inviteCode               String?                   @unique
  parentId                 String?
  workspaceId              String?
  isSuper                  Boolean                   @default(false)
  deletedAt                DateTime?
  deletedBy                String?
  brandName                String?
  businessDesc             String?
  productsInfo             String?
  pricingInfo              String?
  workingHours             String?
  aiTone                   String                    @default("friendly")
  onboardingCompleted      Boolean                   @default(false)
  accounts                 Account[]
  aiAgent                  AIAgent?
  audiences                Audience[]
  automationRules          AutomationRule[]
  automationInteractions   AutomationInteraction[]
  campaigns                Campaign[]
  contacts                 Contact[]
  easyOrdersStore          EasyOrdersStore?
  wooCommerceStore         WooCommerceStore?
  messages                 Message[]
  sentMessages              Message[]                 @relation("MessageSender")
  messageQueues            MessageQueue[]
  notifications            Notification[]
  shopifyStore             ShopifyStore?
  smartFollowUpSettings    SmartFollowUpSetting[]
  storeAutomations         StoreAutomation[]
  storeOrders              StoreOrder[]
  subscription             Subscription?
  templates                Template[]
  trackedClicks            TrackedClick[]
  parent                   User?                     @relation("TeamHierarchy", fields: [parentId], references: [id])
  members                  User[]                    @relation("TeamHierarchy")
  assignedConversations    Contact[]                 @relation("AssignedConversations")
  whatsappAccount          WhatsAppAccount?
  pushSubscriptions        PushSubscription[]
  automationAnalytics      AutomationAnalytics[]
  campaignFollowUpSettings CampaignFollowUpSetting[]
  campaignFollowUpRecords  CampaignFollowUpRecord[]
  products                 Product[]
  brandFAQs                BrandFAQ[]
  brandPolicies            BrandPolicy[]
  aiGuardrail              AIGuardrail?
  salesBehaviorSettings    SalesBehaviorSettings?
  websitePages             WebsitePage[]
  websiteCrawlSettings     WebsiteCrawlSettings?
  productSyncLogs          ProductSyncLog[]
  waniPartnerCards         WaniPartnerCard[]
  googleSheetsConnections  GoogleSheetsConnection[]
  emailVerificationTokens  EmailVerificationToken[]
  protectionClaims         ProtectionClaim[]
  reviewedProtectionClaims ProtectionClaim[]         @relation("ReviewedProtectionClaims")
  protectionAuditLogs      ProtectionAuditLog[]
  affiliate                Affiliate?                @relation("UserAffiliate")
  referral                 Referral?                 @relation("UserReferral")
  receivedRewards          ReferralReward[]          @relation("UserReferralRewards")
  teamInvitations          TeamInvitation[]          @relation("UserTeamInvitations")
  paymentRequests          PaymentRequest[]          @relation("UserPaymentRequests")
  reviewedPaymentRequests  PaymentRequest[]          @relation("PaymentRequestReviewer")

  @@index([email])
  @@index([workspaceId])
  @@index([parentId])
  @@index([deletedAt])
}

// ─── Account — مطلوب لـ NextAuth PrismaAdapter + Google OAuth ────────────────
// بيخزن الـ access_token والـ refresh_token الخاصة بـ Google لكل يوزر
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Subscription {
  id                       String             @id @default(cuid())
  userId                   String             @unique
  plan                     PlanTier           @default(free)
  status                   SubscriptionStatus @default(active)
  isBetaUser               Boolean            @default(false)
  campaignsUsedThisMonth   Int                @default(0)
  mcpCommandsUsedThisMonth Int                @default(0)
  periodResetAt            DateTime           @default(now())
  aiTokensUsedThisMonth    Int                @default(0)
  aiTokensBonusBalance     Int                @default(0)
  currentPeriodStart       DateTime           @default(now())
  currentPeriodEnd         DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  expiryWarningSentAt      DateTime?
  user                     User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([plan])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expires   DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model WhatsAppAccount {
  id             String         @id @default(cuid())
  userId         String         @unique
  accessToken    String
  phoneNumberId  String
  wabaId         String         @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  tokenStatus    WhatsAppTokenStatus @default(UNKNOWN)
  tokenExpiresAt DateTime?
  lastTokenCheckAt DateTime?
  tokenDataAccessExpiresAt DateTime?
  tokenWarning7SentAt DateTime?
  tokenWarning3SentAt DateTime?
  tokenWarning1SentAt DateTime?
  tokenExpiredNotifiedAt DateTime?
  tokenInvalidNotifiedAt DateTime?
  backoffCount   Int            @default(0)
  backoffUntil   DateTime?
  dailyResetAt   DateTime       @default(now())
  dailySentCount Int            @default(0)
  messagingTier  Int            @default(1)
  messageQueues  MessageQueue[]
  automationInteractions AutomationInteraction[]
  protectionClaims       ProtectionClaim[]
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum WhatsAppTokenStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  INVALID
  UNKNOWN
}

model MessageQueue {
  id                String          @id @default(cuid())
  userId            String
  whatsappAccountId String
  phoneNumberId     String
  toPhone           String
  contactId         String?
  messageType       String          @default("template")
  templateName      String?
  templateLang      String          @default("ar")
  templateVars      Json?
  content           String?
  campaignId        String?
  status            QueueStatus     @default(pending)
  scheduledAt       DateTime        @default(now())
  processedAt       DateTime?
  sentAt            DateTime?
  attempts          Int             @default(0)
  maxAttempts       Int             @default(3)
  nextRetryAt       DateTime?
  whatsappMsgId     String?
  error             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  existingMessageId String?
  replyToWhatsappId String?
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  whatsappAccount   WhatsAppAccount @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([phoneNumberId, status])
  @@index([campaignId])
  @@index([userId, status])
  @@index([status, nextRetryAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  link      String?
  meta      Json?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
}

model Audience {
  id        String    @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  type      String    @default("excel")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts  Contact[]
  googleSheetsConnection GoogleSheetsConnection?

  @@index([userId])
}

model GoogleSheetsConnection {
  id              String   @id @default(cuid())
  userId          String
  audienceId      String?  @unique
  accessToken     String?  @db.Text
  refreshToken    String?  @db.Text
  tokenExpiresAt  DateTime?
  spreadsheetId   String?
  spreadsheetName String?
  sheetId         String?
  sheetName       String?
  nameColumn      String?
  phoneColumn     String?
  lastSyncAt      DateTime?
  syncInterval    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  audience        Audience? @relation(fields: [audienceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, syncInterval, lastSyncAt])
}

model Contact {
  id                String             @id @default(cuid())
  phone             String
  audienceId        String?
  createdAt         DateTime           @default(now())
  name              String?
  userId            String
  deletedAt         DateTime?
  isArchived        Boolean            @default(false)
  isPinned          Boolean            @default(false)
  lastMessageAt     DateTime?
  notes             String?
  unreadCount       Int                @default(0)
  updatedAt         DateTime           @updatedAt
  voiceAgentEnabled Boolean            @default(false)
  textAiEnabled     Boolean            @default(true)
  aiStatus          ConversationStatus @default(AUTO)
  handoffReason     String?
  handoffAt         DateTime?
  lastAiRepliedAt   DateTime?
  // ── Conversation Nudge: عدد الـ nudges اللي اتبعتت في الجلسة الحالية ──
  // بيتصفّر لما العميل يبعت رسالة جديدة. cap = 1 نُدج لكل فترة سكوت.
  nudgeCountInThread Int               @default(0)
  audience          Audience?          @relation(fields: [audienceId], references: [id])
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedToUserId  String?
  assignedTo        User?              @relation("AssignedConversations", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  messages          Message[]
  automationInteractions AutomationInteraction[]
  storeOrders       StoreOrder[]

  @@unique([phone, userId])
  @@index([userId])
  @@index([assignedToUserId])
  @@index([phone])
  @@index([lastMessageAt])
}

model Template {
  id                       String                    @id @default(cuid())
  name                     String
  content                  String
  status                   String                    @default("pending")
  userId                   String
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  metaId                   String
  category                 String                    @default("MARKETING")
  language                 String                    @default("ar")
  headerType               String?
  headerText               String?
  footer                   String?
  buttons                  Json?
  rejectedReason           String?
  components               Json?
  automationRules          AutomationRule[]
  campaigns                Campaign[]
  storeAutomations         StoreAutomation[]
  campaignFollowUpSettings CampaignFollowUpSetting[]
  user                     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([metaId, userId])
  @@index([userId])
  @@index([status])
}

model Campaign {
  id                String          @id @default(cuid())
  name              String
  userId            String
  templateId        String?
  sentCount         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  completedAt       DateTime?
  deliveredCount    Int             @default(0)
  failedCount       Int             @default(0)
  readCount         Int             @default(0)
  startedAt         DateTime?
  status            CampaignStatus  @default(draft)
  scheduledAt       DateTime?       @map("scheduled_at")
  queuedCount       Int             @default(0)
  totalQueued       Int             @default(0)
  ordersCount       Int             @default(0)
  revenue           Float           @default(0)
  trackedUrl        String?
  attributionHours  Int             @default(48)
  templateVariables Json?
  template          Template?       @relation(fields: [templateId], references: [id])
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignOrders    CampaignOrder[]
  messages          Message[]

  @@index([userId])
  @@index([status])
  @@index([scheduledAt])
}

model Message {
  id          String            @id @default(cuid())
  content     String?
  userId      String
  senderUserId String?
  campaignId  String?
  contactId   String
  whatsappId  String?           @unique
  createdAt   DateTime          @default(now())
  deletedAt   DateTime?
  deliveredAt DateTime?
  error       String?
  mediaUrl    String?
  readAt      DateTime?
  sentAt      DateTime?
  type        MessageType       @default(text)
  updatedAt   DateTime          @updatedAt
  status      MessageStatus     @default(pending)
  direction   MessageDirection  @default(outbound)
  senderType  MessageSenderType @default(human)
  reactions   Json?             @default("[]")
  replyToMessageId String?
  automationRuleId String?
  campaign    Campaign?         @relation(fields: [campaignId], references: [id])
  contact     Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderUser  User?             @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  replyTo      Message?         @relation("MessageReply", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies      Message[]        @relation("MessageReply")
  automationRule AutomationRule? @relation(fields: [automationRuleId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([senderUserId])
  @@index([contactId])
  @@index([campaignId])
  @@index([automationRuleId])
  @@index([status])
  @@index([createdAt])
  @@index([contactId, createdAt])
  @@index([senderType])
}

model WebhookLog {
  id        String   @id @default(cuid())
  payload   String
  processed Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String?

  @@index([processed])
  @@index([createdAt])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  brandName String
  phone     String
  rating    Int
  content   String
  approved  Boolean  @default(false)
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([approved])
  @@index([createdAt])
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  discountType  String    @default("percent")
  discountValue Float
  maxUses       Int       @default(1)
  usedCount     Int       @default(0)
  expiresAt     DateTime?
  active        Boolean   @default(true)
  /// null = كل الباقات | "starter" | "pro" | "enterprise"
  forPlan       String?
  createdAt     DateTime  @default(now())

  @@index([code])
  @@index([active])
}

/// كارت "WANI Partner" في الداشبورد — اليوزر بيصمم كارته من صفحة
/// /dashboard/wani-partner، وبيدخل الـ rotation بعد موافقة الأدمن من
/// تاب "WANI Partner" في /dashboard/admin (src/app/dashboard/page.tsx بيعرض
/// المعتمد والمفعّل بس).
model WaniPartnerCard {
  id     String @id @default(cuid())
  userId String // حتى 10 كروت لكل يوزر

  /// شكل/حركة الكارت — رقم من 1 لـ 5 (كل رقم تصميم وانيميشن مختلف)
  template  Int    @default(1)
  brandName String
  title     String
  tagline   String
  ctaText   String
  ctaLink   String
  /// صورة الخلفية بس (Cloudinary) — من غير أي نص عليها، النص بيتحط بالكود فوقها
  image     String

  /// حالة مراجعة الأدمن — أي تعديل في المحتوى بيرجّعها pending تاني
  status          WaniPartnerCardStatus @default(pending)
  rejectionReason String?
  reviewedAt      DateTime?
  reviewedBy      String?

  /// تشغيل/إيقاف — بيتحكم فيه اليوزر نفسه بعد الموافقة، من غير ما يحتاج مراجعة تانية
  active Boolean @default(true)
  /// ترتيب الظهور في الـ rotation — الأدمن بيظبطه بين الكروت المعتمدة
  order  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([active])
  @@index([order])
  @@index([userId])
}

enum WaniPartnerCardStatus {
  pending
  approved
  rejected
}

model ShopifyStore {
  id          String            @id @default(cuid())
  userId      String            @unique
  shop        String            @unique
  storeName   String
  accessToken String?
  scope       String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  automations StoreAutomation[]
  orders      StoreOrder[]
}

model EasyOrdersStore {
  id            String            @id @default(cuid())
  userId        String            @unique
  storeName     String
  apiKey        String
  webhookSecret String
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  lastSyncAt    DateTime?
  totalSynced   Int               @default(0)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  automations   StoreAutomation[]
  orders        StoreOrder[]

  @@index([userId])
}

model WooCommerceStore {
  id             String            @id @default(cuid())
  userId         String            @unique
  storeName      String
  storeUrl       String?
  consumerKey    String?
  consumerSecret String?
  isConnected    Boolean           @default(false)
  isActive       Boolean           @default(true)
  totalSynced    Int               @default(0)
  lastSyncAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders         StoreOrder[]
  automations    StoreAutomation[]

  @@index([userId])
}

model AutomationRule {
  id                String                @id @default(cuid())
  userId            String
  name              String
  isEnabled         Boolean               @default(true)
  triggerType       TriggerType
  triggerValue      String?
  replyType         ReplyType
  replyContent      String?
  replyMediaUrl     String? // صورة اختيارية ترسل مع الرد (Cloudinary URL)
  templateId        String?
  extraInstructions String?
  humanKeywords     String[]
  pauseOnReply      Boolean               @default(true)
  interactiveConfig Json?
  analytics         AutomationAnalytics[]
  interactions      AutomationInteraction[]
  messages          Message[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  template          Template?             @relation(fields: [templateId], references: [id])
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isEnabled])
  @@index([triggerType])
  @@index([userId, triggerType])
}

enum AutomationInteractionState {
  WAITING
  PROCESSING
  SUPERSEDED
  COMPLETED
  STALE
  FAILED
}

model AutomationInteraction {
  id                 String                     @id @default(cuid())
  userId             String
  contactId          String
  whatsappAccountId  String
  phoneNumberId      String
  automationRuleId   String
  outboundMessageId  String?
  buttonSnapshot     Json
  state              AutomationInteractionState @default(WAITING)
  selectedButtonId   String?
  processedEventId   String?                    @unique
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  completedAt        DateTime?

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact         Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  whatsappAccount WhatsAppAccount @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)
  automationRule AutomationRule  @relation(fields: [automationRuleId], references: [id], onDelete: Cascade)

  @@index([userId, contactId, state])
  @@index([contactId, state, createdAt])
  @@index([whatsappAccountId, phoneNumberId])
  @@index([automationRuleId])
}

model AIAgent {
  id                String                @id @default(cuid())
  userId            String                @unique
  isEnabled         Boolean               @default(false)
  provider          AIProvider            @default(gemini)
  brandName         String?
  businessDesc      String?
  productsInfo      String?
  pricingInfo       String?
  workingHours      String?
  tone              String                @default("friendly")
  systemPrompt      String?
  languageMode      String                @default("auto")
  websiteUrl        String?
  websiteButtonText String?
  pauseMinutes      Int                   @default(10)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  elevenLabsEnabled Boolean               @default(false)
  elevenLabsApiKey  String?
  elevenLabsAgentId String?
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  analytics         AutomationAnalytics[]
}

// ── Product Catalog ───────────────────────────────────────────────────────────
model Product {
  id                  String        @id @default(cuid())
  userId              String
  source              ProductSource
  externalId          String
  name                String
  description         String?       @db.Text
  price               Float?
  compareAtPrice      Float?
  currency            String        @default("EGP")
  images              String[]      @default([])
  variants            Json?
  stock               Int?
  url                 String?
  category            String?
  tags                String[]      @default([])
  relatedProductIds   String[]      @default([])
  aiNotes             String?       @db.Text
  aiKeywords          String[]      @default([])
  aiSalesInstructions String?       @db.Text
  isActive            Boolean       @default(true)
  searchText          String        @db.Text
  lastSyncedAt        DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([source, externalId, userId])
  @@index([userId, isActive])
  @@index([userId, source])
}

// ── FAQ (الأسئلة الشائعة) ─────────────────────────────────────────────────────
model BrandFAQ {
  id        String   @id @default(cuid())
  userId    String
  question  String
  answer    String   @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── سياسات البراند ────────────────────────────────────────────────────────────
model BrandPolicy {
  id        String     @id @default(cuid())
  userId    String
  type      PolicyType
  title     String
  content   String     @db.Text
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Guardrails (قواعد وحدود المساعد) ──────────────────────────────────────────
model AIGuardrail {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  noInventPrices          Boolean  @default(true)
  noInventProducts        Boolean  @default(true)
  noMentionCompetitors    Boolean  @default(true)
  noSharePersonal         Boolean  @default(true)
  strictKnowledgeOnly     Boolean  @default(true)
  alwaysHandoffComplaints Boolean  @default(true)
  responseStyle           String   @default("natural")
  customRules             String?  @db.Text
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Product Sync Status & Log ────────────────────────────────────────────────
model ProductSyncLog {
  id             String        @id @default(cuid())
  userId         String
  source         ProductSource
  status         String        @default("success")
  productsSynced Int           @default(0)
  errorsCount    Int           @default(0)
  errorMessage   String?
  startedAt      DateTime      @default(now())
  completedAt    DateTime?

